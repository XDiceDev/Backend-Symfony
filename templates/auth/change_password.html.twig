{% extends 'base.html.twig' %}

{% block title %}Изменение пароля{% endblock %}

{% block body %}
    <h1>Изменение пароля</h1>

    {% if app.flashes('error') %}
        <div class="alert alert-danger">
            {{ app.flashes('error')|first }}
        </div>
    {% endif %}
    {% if app.flashes('success') %}
        <div class="alert alert-success">
            {{ app.flashes('success')|first }}
        </div>
    {% endif %}

    <form action="{{ path('app_change_password') }}" method="post">
        <label for="current_password">Текущий пароль:</label>
        <input type="password" id="current_password" name="current_password" required>
        <label for="new_password">Новый пароль:</label>
        <input type="password" id="new_password" name="new_password" required>
        <label for="new_password_confirm">Повторите новый пароль:</label>
        <input type="password" id="new_password_confirm" name="new_password_confirm" required>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('change_password') }}">
        <button type="submit">Изменить пароль</button>
    </form>

    <p><a href="{{ path('app_home') }}">Вернуться на главную</a></p>
{% endblock %}